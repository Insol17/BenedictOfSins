  chapterSelectCamPosition: {x: 1459.3, y: 2160, z: -870.5}
  characterConfirmCamPosition: {x: 1459.3, y: 890, z: -870.5}
  cameraMoveSpeed: 10
  characterNameText: {fileID: 412081379}
  hpText: {fileID: 1108599408}
  characterDescriptionText: {fileID: 1390004036}
  chapterNameText: {fileID: 1463002615}
  gimmickImage1: {fileID: 83749797}
  gimmickImage2: {fileID: 1376442534}
  gimmickImage3: {fileID: 627191745}
  gimmickNameText1: {fileID: 0}
  gimmickNameText2: {fileID: 0}
  gimmickNameText3: {fileID: 0}
  gimmickText1: {fileID: 0}
  gimmickText2: {fileID: 0}
  gimmickText3: {fileID: 0}
  characterImage: {fileID: 2006204934}
  confirmButton: {fileID: 544831438}
  backButton: {fileID: 1809432880}
  characterNames:
  - VIKING
  - FIGHTER
  - SEEKER
  - GUNNER
  - RONIN
  - MUMMY
  - KING
  - THE BOY
  hpValues:
  - 'HP : 100/100'
  - 'HP : 90/90'
  - 'HP : 100/100'
  - 'HP : 60/60'
  - 'HP : 80/80'
  - 'HP : 60/60'
  - 'HP : 110/110'
  - 'HP : 80/80'
  descriptions:
  - "\uBC14\uC774\uD0B9\uC740 \uBD81\uC720\uB7FD \uC2E0\uD654\uC758 \uC138\uACC4
    \uC18D\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC744 \uAC15\uD55C \uC721\uCCB4\uB97C \uC9C0\uB2C8\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.                                               \uBD84\uB178\uD560
    \uC218\uB85D \uAC15\uD574\uC9C0\uB294 \uAD11\uC804\uC0AC\uC758 \uC804\uD22C \uC2A4\uD0C0\uC77C\uC744
    \uAC00\uC84C\uC9C0\uB9CC \uBD84\uB178\uAC00 \uC2DD\uC5B4\uBC84\uB9AC\uBA74 \uACE7\uBC14\uB85C
    \uC804\uC758\uB97C \uC0C1\uC2E4\uD55C\uB2E4\uB294 \uCE58\uBA85\uC801\uC778 \uB2E8\uC810\uC744
    \uAC00\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC2F8\uC6C0\uAFBC\uC740 \uC18C\uC18D \uC5C6\uC774 \uBB34\uC640 \uC758\uB97C
    \uB530\uB77C \uC6C0\uC9C1\uC774\uB294 \uC815\uC758\uB85C\uC6B4 \uBB34\uD611\uC778\uC785\uB2C8\uB2E4.                                                         
    \uC801\uB4E4\uC744 \uB2F5\uD30C\uD574\uB098\uAC00\uBA70 \uB2E4\uC591\uD55C \uC720\uD30C\uC758
    \uBB34\uACF5\uC744 \uBC30\uC6B8 \uC218 \uC788\uC9C0\uB9CC \uC11C\uB85C \uB2E4\uB978
    \uC885\uB958\uC758 \uBB34\uACF5\uC744 \uB108\uBB34 \uB9CE\uC774 \uBC30\uC6B0\uB294
    \uC21C\uAC04 \uD6A8\uC728\uC774 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4."
  - "\uC5EC\uD589\uC790\uB294 \uCC3D\uACFC \uB9C8\uBC95\uC744 \uC4F0\uB294 \uC77C\uC885\uC758
    \uB9C8\uAC80\uC0AC\uC785\uB2C8\uB2E4.   \uC5EC\uD589\uC790\uC758 \uB9C8\uBC95\uC740
    \uC2E0\uB4E4\uC5D0\uAC8C\uC11C \uD798\uC744 \uBE4C\uB824\uC624\uB294 \uBC29\uC2DD\uC73C\uB85C
    \uC791\uB3D9\uD558\uC9C0\uB9CC.. \uB2A5\uB825\uC774 \uB41C\uB2E4\uBA74 \uC2E0\uC744
    \uC8FD\uC5EC \uBE7C\uC557\uC544\uB3C4 \uB420 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4.                                                                         
    \uC2E0\uC5D0\uAC8C\uC11C \uB2A5\uB825\uC744 \uD55C \uBC88\uC5D0 \uB108\uBB34
    \uB9CE\uC774 \uBE4C\uB824\uC624\uBA74 \uC2E0\uC5D0\uAC8C \uBC8C\uC744 \uBC1B\uC744
    \uC218 \uC788\uC73C\uB2C8 \uC870\uC2EC\uD558\uC138\uC694.                            
    \uAE30\uC5B5\uD558\uC138\uC694 \uC5EC\uD589\uC790\uB294 '\uC544\uBB34\uB3C4 \uC544\uB2D9\uB2C8\uB2E4.'"
  - "\uCD1D\uC7A1\uC774\uB294 \uBBF8\uC815\uBD80\uC758 \uC0C8\uB85C\uC6B4 \uC815\uCC45
    \uB54C\uBB38\uC5D0 \uCAD3\uAE30\uB294 \uC2E0\uC138\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.                                                                 
    \uD53C\uC2A4\uD1A8, \uC0F7\uAC74, \uB9AC\uD53C\uD130\uAE4C\uC9C0 \uCD1D \uC138\uC790\uB8E8\uC758
    \uCD1D\uC744 \uB2E4\uB8E8\uB294 \uBA85\uC0AC\uC218\uC774\uC9C0\uB9CC \uC804\uD22C
    \uB3C4\uC911 \uD0C4\uC57D\uC774 \uB2E4 \uB5A8\uC5B4\uC9C4\uB2E4\uBA74...... \uC218\uAE09\uD560
    \uBC29\uBC95\uC740 \uC874\uC7AC\uD558\uC9C0 \uC54A\uC73C\uB2C8 \uD0C4\uC57D\uC744
    \uC798 \uAD00\uB9AC\uD574\uC57C \uD560 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - "\uBC29\uB791\uBB34\uC0AC\uB294 \uB3C8\uC774 \uC544\uB2CC \uBA85\uC608\uB97C
    \uC887\uB294 \uC815\uC758\uB85C\uC6B4 \uC6A9\uBCD1\uC785\uB2C8\uB2E4.                                                                                   
    \uC5EC\uD589\uAE38\uC5D0 \uB098\uC11C \uB2E4\uC591\uD55C \uBB34\uC0AC, \uB0AD\uC778,
    \uAC80\uAC1D\uB4E4\uACFC \uC0DD\uC0AC\uACB0\uC744 \uB098\uB204\uC5B4 \uADF8\uB4E4\uC758
    \uAE30\uC220\uC744 \uBC30\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.             
    \uB108\uBB34\uB098\uB3C4 \uC815\uC758\uB85C\uC6B4 \uC6A9\uBCD1\uC740 \uC5EC\uC131\uACFC
    \uC544\uC774\uB97C \uD574 \uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.                                                                        
    \uC2F8\uC6B8 \uC218 \uBC16\uC5D0 \uC5C6\uB294 \uC0C1\uD669\uC5D0\uC11C\uC870\uCC28
    \uC8FC\uC800\uD558\uB294 \uAC15\uC778\uD55C \uC2E0\uB150\uC744 \uAC00\uC9C0\uACE0
    \uC788\uC2B5\uB2C8\uB2E4..."
  - "\uC774 \uBBF8\uB77C\uB294 \uC798 \uBCF4\uC874\uB420\uAC78 \uBCF4\uB2C8 \uC0B4\uC544\uC0DD\uC804
    \uC655\uC871\uC774\uC5C8\uB098\uBD05\uB2C8\uB2E4.                                                                                
    \uADF8\uC57C\uB9D0\uB85C \uD669\uAE08\uC758 \uD654\uC2E0\uC778 \uAC83 \uCC98\uB7FC
    \uC774 \uBBF8\uB77C\uB294 \uD669\uAE08\uC744 \uC790\uC2E0\uC758 \uD798\uC73C\uB85C
    \uCE58\uD658\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.                               
    \uD558\uC9C0\uB9CC \uBBF8\uB77C\uB294 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uD658\uC601\uBC1B\uC9C0
    \uBABB\uD569\uB2C8\uB2E4.                                       \uC0C1\uC810\uACFC
    \uD734\uC2DD\uC744 \uC774\uC6A9\uD560 \uB54C \uC0AC\uB78C\uB4E4\uC758 \uB208\uCD08\uB9AC\uB97C
    \uD53C\uD560 \uC218 \uC5C6\uB098\uBD05\uB2C8\uB2E4."
  - "\uADF8\uC57C\uB9D0\uB85C '\uC655'\uC785\uB2C8\uB2E4. \uC704\uC5C4\uC788\uB294
    \uD48D\uCC44\uC640 \uC808\uB3C4\uC788\uB294 \uB3D9\uC791\uC740 \uD55C \uCE58\uC758
    \uD2C8\uB3C4 \uC5C6\uC5B4\uBCF4\uC785\uB2C8\uB2E4.                                       
    \uD558\uC9C0\uB9CC \uC774 \uC655\uC740 \uBB34\uC5D0\uB9CC \uC9D1\uC911\uD55C
    \uB098\uBA38\uC9C0 \uD559\uBB38\uC5D0 \uB73B\uC744 \uB450\uC9C0 \uBABB\uD558\uC600\uC2B5\uB2C8\uB2E4.   "
  - "\uBAA8\uB4E0 \uC8C4\uC545\uC744 \uAE68\uB2EB\uACE0 \uAECD\uC9C8\uC744 \uAE68
    \uD658\uC0DD\uD55C '\uC544\uC774'\uC785\uB2C8\uB2E4.                                 
    \uC790\uC2E0\uC744 \uC8FD\uC778 \uBC40\uC5D0\uAC8C \uBCF5\uC218\uD560 \uC9C0,
    \uC2A4\uC2A4\uB85C\uC758 \uC798\uBABB\uC744 \uC778\uC815\uD560\uC9C0.                                                                             
    \uC120\uD0DD\uC740 \uB2F9\uC2E0\uC758 \uBAAB\uC785\uB2C8\uB2E4. "
  chapterNames:
  - BLIND WRATH
  - PRIDE and VIRTUE
  - UNTERM JEALOUSY
  - GLUTTONY DOGS
  - LUST and HONOR
  - GREEDY GOLDRUSH
  - for SLOTH the BELL TOLLS
  - FACE THE SIN
