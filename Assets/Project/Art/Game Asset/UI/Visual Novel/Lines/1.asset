      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC815\uC6D0\uC5D0 \uD55C \uB208\uC774 \uD314\uB824\uC788\uB358
      \uC0AC\uC774 \uACC4\uB780\uC758 \uC55E\uC5D0\uB294 \uD55C \uC0AC\uB0B4\uAC00
      \uC11C \uC788\uC5C8\uB2E4."
    actions: []
  - speakerName: ???
    dialogueText: "\uB610\uB2E4\uB978 \uC8C4\uC778\uC774\uAD70."
    actions:
    - actionType: 7
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: "\uACC4\uB780"
    dialogueText: "\uB2F9\uC2E0\uC740..?"
    actions:
    - actionType: 7
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 6
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 1
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: ???
    dialogueText: "\uC5ED\uC2DC \uAE30\uC5B5\uC740 \uC5C6\uB294\uAC74\uAC00."
    actions:
    - actionType: 7
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 6
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
