  lines:
  - speakerName: 
    dialogueText: "\uAC74\uBB3C \uB0B4\uBD80\uB294 \uC815\uC801 \uADF8 \uC790\uCCB4."
    actions:
    - actionType: 2
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 6
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 2
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uBE5B\uC774\uB77C\uACE4 \uC5C6\uB294 \uCE60\uD751\uC774 \uC2A4\uC2A4\uB85C\uC758
      \uADF8\uB9BC\uC790\uC870\uCC28 \uC0BC\uCF30\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uBB34\uC5C7\uC5D0 \uCAD3\uAE30\uB4EF, \uD639\uC740 \uBD80\uB984\uC744
      \uB4E3\uB294 \uB4EF.  "
    actions: []
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC758 \uBC1C\uAC78\uC74C\uC740 \uBA48\uCD9C \uC904
      \uBAB0\uB790\uACE0, \uB9C8\uC74C\uC5D4 \uC54C \uC218 \uC5C6\uB294 \uACB0\uD54D\uC774
      \uC790\uB77C\uB0AC\uB2E4. "
    actions: []
  - speakerName: 
    dialogueText: "\uADF8\uAC74 \uC8C4\uCC45\uAC10\uC77C\uAE4C, \uADF8\uB9AC\uC6C0\uC77C\uAE4C.
      \uC544\uB2C8\uBA74\u2026 \uC2AC\uD514?"
    actions: []
  - speakerName: 
    dialogueText: "\uAE30\uB465\uACFC \uBCBD, \uC218\uCC9C\uC758 \uCC45\uC7A5\uC774
      \uB05D\uC5C6\uC774 \uC774\uC5B4\uC9C0\uB294 \uD68C\uB791."
    actions: []
  - speakerName: 
    dialogueText: "\uB9C8\uCE58 \uBB34\uB364\uCC98\uB7FC \uBCF4\uC774\uB294 \uC774\uACF3\uC758
      \uC911\uC2EC\uC5D0 \uB2E4\uB2E4\uB974\uC790 \uB113\uC740 \uC815\uC6D0\uC774
      \uBCF4\uC600\uB2E4."
    actions:
    - actionType: 3
      targetName: Background 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC815\uC6D0\uC758 \uC911\uC2EC, \uB098\uBB34\uC758 \uAE30\uB465\uC774
      \uC19F\uC544\uC624\uB978 \uADF8 \uACF3\uC744 \uBC14\uB77C\uBCF4\uC790"
    actions: []
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC740 \uBB34\uC5B8\uAC00\uB97C \uB290\uAF08\uB2E4.
      \uB530\uB73B\uD55C\u2026 \uC775\uC219\uD55C \uAC10\uAC01."
    actions: []
  - speakerName: 
    dialogueText: "\uADF8\uB54C\uC600\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "(\uB178\uC774\uC988) \uC800 \uC0AC\uACFC \uC880 \uB530\uC918!
      \uC774\uAC74 \uC369\uC5C8\uC5B4\u2026 \uB2E4\uB978 \uAC78\uB85C \uC918!"
    actions:
    - actionType: 8
      targetName: Postprocess
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 5
      intensity: 1
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 3
      targetName: Background 2 Gray
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 5
      intensity: 1
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC9C0\uB048\uAC70\uB9AC\uB294 \uBA38\uB9AC \uC18D\uC744 \uAC00\uB974\uBA70,
      \uC78A\uD600\uC9C4 \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB4E4\uC5C8\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uC9C0\uB048\uAC70\uB9BC\uC774 \uC870\uAE08 \uAC00\uC2DC\uACE0
      \uB2E4\uC2DC \uBC14\uB77C\uBCF8 \uC815\uC6D0\uC5D0\uB294 \uAE30\uC2DC\uAC10\uB9CC\uC774
      \uAC10\uB3CC\uC558\uB2E4."
    actions:
    - actionType: 8
      targetName: Postprocess
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 3
      targetName: Background 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: ???
    dialogueText: .....
    actions:
    - actionType: 1
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 6
      targetName: Character 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 7.36
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 3
