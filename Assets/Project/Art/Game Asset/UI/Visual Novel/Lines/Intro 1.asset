  m_Script: {fileID: 11500000, guid: b8c3b8b640b6c6d4db32dee859ee3f14, type: 3}
  m_Name: Intro 1
  m_EditorClassIdentifier: 
  scriptName: Intro 1
  lines:
  - speakerName: 
    dialogueText: "\u201C\uC138\uC0C1\uC774 \uC704\uD5D8\uD55C \uC774\uC720\uB294
      \uC545\uD55C \uC790\uB4E4 \uB54C\uBB38\uC774 \uC544\uB2C8\uB77C, \uCE68\uBB35\uD558\uB294
      \uC120\uD55C \uC790\uB4E4 \uB54C\uBB38\uC774\uB2E4.\u201D\r"
    actions:
    - actionType: 2
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 3
      targetName: Background 1
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\r\u2013 \uC54C\uBCA0\uB974\uD2B8 \uC544\uC778\uC288\uD0C0\uC778"
    actions: []
  - speakerName: 
    dialogueText: BENEDICT of SINS.
    actions: []
  - speakerName: 
    dialogueText: "\uCE60\uD751\uC73C\uB85C \uAC80\uAC8C \uBB3C\uB4E0 \uC232."
    actions:
    - actionType: 3
      targetName: Background 3
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uBAA8\uB4E0 \uC0C9\uC774 \uCE68\uBB35\uD558\uB294 \uC774 \uACF5\uAC04\uC5D0\uC11C,
      \uBB34\uC5B8\uAC00\uAC00 \uB208\uC744 \uB72C\uB2E4."
    actions:
    - actionType: 0
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uACC4\uB780."
    actions:
    - actionType: 1
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC774\uB984 \uC5C6\uB294 \uC721\uCCB4."
    actions:
    - actionType: 0
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uAE30\uC5B5\uB3C4 \uC5C6\uC774 \uADF8\uC800 \uC874\uC7AC\uD558\uAC8C\uB41C
      \uAC83."
    actions: []
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC740 \uC790\uC2E0\uC774 \uB204\uAD6C\uC778\uC9C0,
      \uC774\uACF3\uC740 \uC5B4\uB514\uC778\uC9C0 \uB5A0\uC62C\uB824 \uBCF4\uB824\uACE0
      \uD588\uC9C0\uB9CC \uB5A0\uC624\uB974\uB294 \uAC83\uC740 \uC544\uBB34 \uAC83\uB3C4
      \uC5C6\uC5C8\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "(\uBA38\uB9AC\uAC00 \uC9C0\uB048\uAC70\uB9AC\uBA70 \uD658\uCCAD\uC774
      \uB4E4\uB824\uC628\uB2E4.)"
    actions:
    - actionType: 8
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 5
      intensity: 1
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "( (\uB178\uC774\uC988) \uC6D0\uB9DD\uC774 \uAE43\uB4E0 \uBAA9\uC18C\uB9AC)"
    actions:
    - actionType: 0
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: "\uACC4\uB780"
    dialogueText: ......?
    actions:
    - actionType: 8
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 10
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 8300000, guid: 2e0cc6e914d96cd49a357d2b90e32bc9, type: 3}
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC740 \uC774\uACF3\uC774 \uC5B4\uB514\uC778\uC9C0
      \uD30C\uC545\uD574\uBCF4\uACE0\uC790 \uC55E\uC73C\uB85C \uB098\uC544\uAC14\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uC6B0\uAC70\uC9C4 \uB098\uBB34\uB4E4\uC744 \uB118\uC5B4 \uC808\uBCBD\uC758
      \uB05D\uC5D0 \uB2E4\uB2E4\uB974\uC790 \uD558\uB298\uC5D0 \uC218\uB193\uC778
      \uC740\uD558\uC218\uAC00 \uBCF4\uC600\uB2E4."
    actions:
    - actionType: 3
      targetName: Background 5
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC544\uC8FC \uB192\uC774 \uB5A0\uC788\uB294 \uC800 \uBCC4\uB4E4\uC758
      \uC9D1\uD569\uCCB4\uB4E4\uC740 \uC0B4\uC544\uC11C \uC808\uB300 \uB2FF\uC744
      \uC218 \uC5C6\uC73C\uB9AC\uB77C \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uD558\uC9C0\uB9CC \uADF8\uB7F0 \uC0DD\uAC01\uB3C4 \uC7A0\uC2DC,
      \uACE0\uAC1C\uB97C \uB3CC\uB9AC\uC790 \uC790\uC2E0\uC758 \uC0DD\uAC01\uC774
      \uD2C0\uB838\uC74C\uC744 \uC54C\uC558\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uC800 \uBA40\uB9AC \uAC70\uB300\uD55C \uD55C \uADF8\uB8E8\uC758
      \uB098\uBB34."
    actions:
    - actionType: 3
      targetName: Background 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
    - actionType: 2
      targetName: Character 2
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uADF8 \uB098\uBB34\uB294 \uD558\uB298 \uB192\uC774 \uC19F\uC544
      \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uC6B0\uC8FC\uB97C \uBD80\uC220 \uAE30\uC138\uC600\uB2E4."
    actions: []
  - speakerName: "\uACC4\uB780"
    dialogueText: "\uB2F9\uC7A5\uC740 \uB2E8\uC11C\uAC00 \uC5C6\uC5B4."
    actions: []
  - speakerName: "\uACC4\uB780"
    dialogueText: "\uC77C\uB2E8 \uC800 \uB098\uBB34\uB85C \uD5A5\uD574\uBCF4\uB294
      \uC218 \uBC16\uC5D0..."
    actions: []
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC740 \uC808\uBCBD\uC758 \uB05D\uC5D0 \uB098\uC788\uB358
      \uC0DB\uAE38\uC744 \uC774\uC6A9\uD574 \uC870\uC2EC\uD788 \uBC14\uB2E5\uC5D0
      \uB0B4\uB824\uC654\uB2E4."
    actions:
    - actionType: 3
      targetName: Background 4
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uBC14\uB2E5\uC5D0 \uB2FF\uC740 \uACC4\uB780\uC758 \uC8FC\uC704\uB97C
      \uAC10\uC2F8\uB294 \uAC83\uC740, \uBB34\uB108\uC9C4 \uAE30\uB465\uACFC \uBC14\uC2A4\uB77C\uC9C4
      \uC0B6\uC758 \uC794\uD574."
    actions:
    - actionType: 0
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uC774\uACF3\uC774 \uD55C \uB54C \uB9C8\uC744\uC774\uC5C8\uB2E4\uB294
      \uC0AC\uC2E4\uC740, \uBC14\uB78C\uC5D0 \uD769\uB0A0\uB9AC\uB294 \uCC9C \uC870\uAC01\uC774
      \uB9D0\uD574\uC900\uB2E4."
    actions: []
  - speakerName: "\uACC4\uB780"
    dialogueText: "\uD3D0\uD5C8\uC778\uAC00..."
    actions: []
  - speakerName: 
    dialogueText: "\uC774 \uD3D0\uD5C8\uB4E4\uC740 \uB098\uBB34\uC758 \uAE30\uB465
      \uC8FC\uC704\uB97C \uC544\uC6B0\uB974\uACE0 \uC788\uC5C8\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uACC4\uB780\uC740 \uB098\uBB34 \uC8FC\uC704\uC5D0 \uBB49\uCCD0
      \uD06C\uAC8C \uBC1C\uC804\uD588\uB358 \uB9C8\uC744 \uD639\uC740 \uAD6D\uAC00\uC600\uC73C\uB9AC\uB77C
      \uC0DD\uAC01\uD588\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uD3D0\uD5C8\uB97C \uB51B\uACE0 \uB098\uC544\uAC04 \uACC4\uB780\uC740
      \uB4DC\uB514\uC5B4 \uB098\uBB34\uC758 \uBC11\uB465\uC5D0 \uB2E4\uB2E4\uB790\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uADF8\uACF3\uC5D0\uB294 \uAC70\uB300\uD55C \uAC74\uBB3C\uC774
      \uC788\uC5C8\uB2E4."
    actions:
    - actionType: 3
      targetName: Background 6
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: 
      soundClip: {fileID: 0}
  - speakerName: 
    dialogueText: "\uB098\uBB34\uC758 \uBC11\uB465\uC744 \uB458\uB7EC\uC2F8\uB294
      \uADF8 \uAC74\uBB3C\uC740 \uC2E0\uC131\uD574\uBCF4\uC774\uBA74\uC11C\uB3C4
      \uACF5\uD5C8\uD55C \uB290\uB08C\uC744 \uD48D\uAE30\uACE0 \uC788\uC5C8\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uADF8 \uB530\uC2A4\uD558\uBA74\uC11C\uB3C4 \uC2DC\uB9AC\uB3C4\uB85D
      \uCC28\uAC00\uC6B4 \uC774\uC9C8\uC801\uC778 \uB290\uB08C\uC5D0 \uACC4\uB780\uC740
      \uBB18\uD55C \uB290\uB08C\uC744 \uBC1B\uC558\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "\uADF8\uB7F0 \uC774\uC9C8\uC801\uC778 \uB290\uB08C\uC5D0\uB3C4
      \uBD88\uAD6C\uD558\uACE0 \uACC4\uB780\uC740 \uC54C \uC218 \uC5C6\uB294 \uC774\uC720\uB85C
      \uC774\uACF3\uC5D0 \uC774\uB04C\uB838\uB2E4."
    actions: []
  - speakerName: 
    dialogueText: "(\uAC74\uBB3C\uC5D0 \uC9C4\uC785\uD55C\uB2E4.)"
    actions: []
  - speakerName: 
    dialogueText: "(\uAC74\uBB3C\uC5D0 \uC9C4\uC785\uD55C\uB2E4.)"
    actions:
    - actionType: 9
      targetName: 
      targetPosition: {x: 0, y: 0, z: 0}
      duration: 0
      intensity: 0
      sceneName: Cutscene 1
      soundClip: {fileID: 0}
  nextSceneName: Cutscene 1
